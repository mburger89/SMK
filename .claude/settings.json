{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "greptile@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-build-dirs.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-sdkconfig.sh\""
          }
        ]
      }
    ]
  }
}
