; Single-wire NRZ driver for WS2812/SK6812-family addressable LEDs (used here
; for the smk_kbd_rp2040 board's SK6812MINI-E chain — GPIO17, via the
; SN74AHCT1G125 level shifter). This is the standard, widely-used PIO program
; from the RP2040 community (functionally the same one pico-examples ships
; for WS2812); its ~800kHz bit timing is within both chips' datasheet
; tolerances, which is why WS2812 and SK6812 chains are routinely driven by
; the exact same PIO code.
;
; Consumed by led_strip_driver.c via the generated ws2812.pio.h
; (pico_generate_pio_header() in CMakeLists.txt).

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1] ; Shift 1 bit out, set pin low for T3 cycles
    jmp !x do_zero side 1 [T1 - 1] ; On a '0' bit go to do_zero, else fall through; pin high for T1 cycles
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; '1' bit: continue driving high for T2 more cycles
do_zero:
    nop            side 0 [T2 - 1] ; '0' bit: pin low for T2 more cycles
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_program_init(PIO pio, uint sm, uint offset, uint pin, float freq, bool rgbw) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, false, true, rgbw ? 32 : 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    int cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    float div = clock_get_hz(clk_sys) / (freq * cycles_per_bit);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
